            // åªæœ‰å½“lastä¸æ˜¯æ ¹å·æˆ–ä¸‰è§’å‡½æ•°æ—¶æ‰è¿½åŠ æ•°å­—
            if (last !== CommonConstants.SQRT && last !== CommonConstants.SIN &&
                last !== CommonConstants.COS && last !== CommonConstants.TAN) {
                this.expressions[len - 1] += value;
            }
