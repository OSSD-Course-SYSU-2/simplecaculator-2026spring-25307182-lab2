            case Symbol.SQRT:
                symbol = CommonConstants.SQRT;
                break;
            case Symbol.SIN:
                symbol = CommonConstants.SIN;
                break;
            case Symbol.COS:
                symbol = CommonConstants.COS;
                break;
            case Symbol.TAN:
                symbol = CommonConstants.TAN;
