                    // æ¸…ç©ºè¡¨è¾¾å¼æ•°ç»„ï¼Œä½†ä¿ç•™inputValueæ˜¾ç¤ºåŸå§‹è¡¨è¾¾å¼
                    this.expressions = [];
                    // å°†è®¡ç®—ç»“æœæ¨å…¥è¡¨è¾¾å¼æ•°ç»„ï¼Œä»¥ä¾¿ç»§ç»­è®¡ç®—
                    this.expressions.push(this.calValue);
